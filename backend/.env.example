# ── DravyaSense Backend Environment Variables ─────────────────────
# Copy this file to .env and fill in values for your environment.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# Database
# Development: SQLite (no setup required)
DATABASE_URL=sqlite+aiosqlite:///./data/dravyasense.db

# Production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dravyasense

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
